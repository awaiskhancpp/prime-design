DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Contact form ---------------------------------------------------------
# reCAPTCHA v2 checkbox. Both are optional: with no secret the endpoint accepts
# submissions and records `recaptchaStatus: not-configured`; the moment the
# secret is set, a missing or invalid token is rejected with a 400. The public
# key makes the widget render on the forms.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3 only — minimum score to accept (WordPress used 0.5). Ignored by v2.
RECAPTCHA_MIN_SCORE=0.5

# Not used yet. Delivery is inert until a destination is confirmed; see
# src/lib/leadIntegrations.ts.
# CONTACT_NOTIFICATION_TO=
# CONTACT_FROM_EMAIL=
# RESEND_API_KEY=
# HUBSPOT_PRIVATE_APP_TOKEN=
