DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- Contact form captcha -------------------------------------------------
# Two providers are wired; src/lib/captcha.ts picks Turnstile when its secret
# is present and falls back to reCAPTCHA otherwise. All four keys are optional:
# with no secret at all the endpoint accepts submissions and records
# `recaptchaStatus: not-configured`; the moment a secret is set, a missing or
# invalid token is rejected with a 400.
#
# Set BOTH halves of one provider or neither. A site key with no matching
# secret renders one provider's widget in the browser while the server checks
# for the other's token, and every real submission is rejected.

# Cloudflare Turnstile — the provider in use.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# reCAPTCHA v2 checkbox — fallback, only consulted when TURNSTILE_SECRET_KEY
# is unset.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3 only — minimum score to accept (WordPress used 0.5). Ignored by v2.
RECAPTCHA_MIN_SCORE=0.5

# Not used yet. Delivery is inert until a destination is confirmed; see
# src/lib/leadIntegrations.ts.
# CONTACT_NOTIFICATION_TO=
# CONTACT_FROM_EMAIL=
# RESEND_API_KEY=
# HUBSPOT_PRIVATE_APP_TOKEN=

# --- Maps -----------------------------------------------------------------
# Browser key for the Google Maps JavaScript API, used by the service-areas
# coverage map (src/components/blocks/ServiceAreasMap.tsx) and, when set, by
# the project location map. Enable "Maps JavaScript API" on the key and
# restrict it by HTTP referrer — it is public by design (NEXT_PUBLIC_*).
# Without it both maps fall back to Google's keyless embed, which cannot be
# custom-styled: the section renders plain Google chrome instead of the
# site's paper-and-brass basemap.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyD7cMnFDhx-C18hDYVtukfcZ2E3pV942Jc
